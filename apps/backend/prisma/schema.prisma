generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id                 Int               @id @default(autoincrement())
  name               String
  email              String            @unique
  password_hash      String
  role               String            @default("ADMIN")
  is_active          Boolean           @default(true)
  failed_login_count Int               @default(0)
  locked_at          DateTime?
  created_at         DateTime          @default(now())
  last_login_at      DateTime?

  uploads            DatasetUpload[]

  @@map("users")
}

model TriageRecord {
  id              Int               @id @default(autoincrement())
  symptom_text    String
  departments     String            @default("")
  num_labels      Int               @default(0)
  dataset_version String?
  created_at      DateTime          @default(now())

  // 17 AI-assigned binary departments
  medicine        Int @default(0)
  neurology       Int @default(0)
  surgery         Int @default(0)
  gastroenterology Int @default(0)
  pediatrics      Int @default(0)
  cardiology      Int @default(0)
  ent             Int @default(0)
  orthopedics     Int @default(0)
  endocrinology   Int @default(0)
  nephrology      Int @default(0)
  psychiatry      Int @default(0)
  dermatology     Int @default(0)
  pulmonology     Int @default(0)
  ophthalmology   Int @default(0)
  hematology      Int @default(0)
  urology         Int @default(0)
  gynecology      Int @default(0)
  rheumatology    Int @default(0)

  upload_id       Int?

  verifications   Verification[]
  upload          DatasetUpload?    @relation(fields: [upload_id], references: [id])

  @@index([upload_id])
  @@map("triage_records")
}

model CrowdWorker {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  bmdc_reg_number String?
  created_at      DateTime @default(now())

  verifications   Verification[]

  @@map("crowd_workers")
}

model Verification {
  id                    Int          @id @default(autoincrement())
  record_id             Int
  worker_id             Int
  verified_departments  Json
  clinical_note         String?
  is_unable_to_assess   Boolean      @default(false)
  draft                 Json?
  submitted_at          DateTime?
  updated_at            DateTime     @updatedAt
  claimed_at            DateTime?
  is_submitted          Boolean      @default(false)

  record                TriageRecord @relation(fields: [record_id], references: [id])
  worker                CrowdWorker  @relation(fields: [worker_id], references: [id])

  @@unique([record_id, worker_id])
  @@index([worker_id])
  @@index([record_id])
  @@map("verifications")
}

model DatasetUpload {
  id               Int      @id @default(autoincrement())
  filename         String
  uploaded_by      Int
  record_count     Int
  upload_timestamp DateTime @default(now())
  version_tag      String?

  admin            User     @relation(fields: [uploaded_by], references: [id])
  triage_records   TriageRecord[]

  @@map("dataset_uploads")
}
