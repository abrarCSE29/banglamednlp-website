# Supabase — copy from Supabase dashboard > Settings > Database
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

JWT_SECRET="your-secret-here"
JWT_REFRESH_SECRET="your-refresh-secret-here"

# SMTP — use Gmail App Password or SendGrid in prod
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""

# Comma-separated list of allowed frontend origins.
# You can use FRONTEND_URL for a single origin or FRONTEND_URLS for multiple origins.
# FRONTEND_URL="http://localhost:3000"
FRONTEND_URLS="http://localhost:3000,https://banglamednlp-frontend.vercel.app,https://banglamednlp.abrarhameem.me"
# Do not include /api here; these must be frontend origins only.
ADMIN_SEED_EMAIL="admin@research.com"
ADMIN_SEED_PASSWORD="Admin@1234"
